# Cloudflare Pages Custom Edge Caching & Security Headers
# SSOT: public/_headers

# 1. Immutable Static Chunks & Media
/foto-zadit.jpg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg
  X-Content-Type-Options: nosniff

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/x-icon
  X-Content-Type-Options: nosniff

/icon.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml
  X-Content-Type-Options: nosniff

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/cv.pdf
  Cache-Control: public, max-age=31536000, immutable
  Content-Disposition: inline; filename="Muhammad_Khoiruzzadittaqwa_CV.pdf"
  X-Content-Type-Options: nosniff

# 2. Machine Surfaces (AI Agents & Crawler Discovery)
/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: text/plain; charset=utf-8

/llms.json
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: application/json; charset=utf-8

/cv.json
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: application/json; charset=utf-8

/.well-known/agent.json
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: application/json; charset=utf-8

/feed.xml
  Cache-Control: public, max-age=1800, s-maxage=3600, stale-while-revalidate=86400
  Content-Type: application/rss+xml; charset=utf-8

# 3. Global Security Defaults (No Cache-Control here to prevent duplication on specific paths)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://va.vercel-scripts.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.googleapis.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com;
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
